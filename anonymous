#!/bin/sh
# Anonymous Internet Navigation Script
#
# Updated for modern Kali Linux (systemd, iproute2, systemd-resolved)
# Author: MardoxTV
# Maintained by: MardoxTV
# Version: 2.5

# List, separated by spaces, of destinations you do NOT want routed through Tor
NON_TOR="192.168.0.0/16 172.16.0.0/12"

# The UID as which Tor runs
TOR_UID="debian-tor"

# Tor TransPort
TRANS_PORT="9040"

# List, separated by spaces, of process names that should be killed
TO_KILL="chrome chromium dropbox firefox pidgin skype thunderbird xchat"

# List, separated by spaces, of BleachBit cleaners
BLEACHBIT_CLEANERS="bash.history system.cache system.clipboard system.custom system.recent_documents system.rotated_logs system.tmp system.trash"

# Overwrite files to hide contents
OVERWRITE="true"

# The default local hostname
REAL_HOSTNAME="kali"

# DNS backup file location
DNS_BACKUP="/etc/network/resolv.conf.backup"

# Include default options, if any
if [ -f /etc/default/kali-anonymous ] ; then
    . /etc/default/kali-anonymous
fi

warning() {
    printf "\n[!] WARNING! This script mitigates common system data leaks.\n"
    printf "    Your behaviour is the key to strong privacy protection.\n"
    printf "\n[i] Edit /etc/default/kali-anonymous to customise your settings.\n"
}

# General-purpose Yes/No prompt
ask() {
    while true; do
        if [ "${2:-}" = "Y" ]; then
            prompt="Y/n"
            default=Y
        elif [ "${2:-}" = "N" ]; then
            prompt="y/N"
            default=N
        else
            prompt="y/n"
            default=
        fi

        printf "\n"
        read -p "$1 [$prompt] > " REPLY

        if [ -z "$REPLY" ]; then
            REPLY=$default
        fi

        case "$REPLY" in
            Y*|y*) return 0 ;;
            N*|n*) return 1 ;;
        esac
    done
}

# Make sure only root can run this script
check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        printf "\n[!] This script must run as root\n\n" >&2
        exit 1
    fi
}

# Detect the correct NetworkManager service name
nm_service() {
    if systemctl list-units --type=service 2>/dev/null | grep -q "NetworkManager.service"; then
        echo "NetworkManager"
    elif systemctl list-units --type=service 2>/dev/null | grep -q "network-manager.service"; then
        echo "network-manager"
    else
        echo ""
    fi
}

nm_stop() {
    NM=$(nm_service)
    if [ -n "$NM" ]; then
        systemctl stop "$NM" 2>/dev/null && printf " * Stopped %s\n" "$NM" || printf " * Failed to stop %s\n" "$NM"
    else
        printf " * NetworkManager not found, skipping\n"
    fi
}

nm_start() {
    NM=$(nm_service)
    if [ -n "$NM" ]; then
        systemctl start "$NM" 2>/dev/null && printf " * Started %s\n" "$NM" || printf " * Failed to start %s\n" "$NM"
    else
        printf " * NetworkManager not found, skipping\n"
    fi
}

# Kill processes at startup
kill_process() {
    if [ "$TO_KILL" != "" ]; then
        killall -q $TO_KILL 2>/dev/null
        printf " * Killed processes to prevent leaks\n"
    fi
}

# Release DHCP address
clean_dhcp() {
    dhclient -r 2>/dev/null
    rm -f /var/lib/dhcp/dhclient*
    printf " * DHCP address released\n"
}

# Change the local hostname
change_hostname() {
    printf "\n"

    CURRENT_HOSTNAME=$(hostname)

    clean_dhcp

    # Try multiple word list locations
    WORDLIST=""
    for f in /usr/share/dict/words /etc/dictionaries-common/words /usr/share/dict/american-english; do
        if [ -f "$f" ]; then
            WORDLIST="$f"
            break
        fi
    done

    if [ -n "$WORDLIST" ]; then
        RANDOM_HOSTNAME=$(shuf -n 1 "$WORDLIST" | sed -r 's/[^a-zA-Z]//g' | awk '{print tolower($0)}')
    else
        RANDOM_HOSTNAME="host$(shuf -i 1000-9999 -n 1)"
    fi

    NEW_HOSTNAME=${1:-$RANDOM_HOSTNAME}

    echo "$NEW_HOSTNAME" > /etc/hostname
    sed -i 's/127.0.1.1.*/127.0.1.1\t'"$NEW_HOSTNAME"'/g' /etc/hosts

    hostname "$NEW_HOSTNAME"

    if [ -f "$HOME/.Xauthority" ] ; then
        su "$SUDO_USER" -c "xauth -n list | grep -v $CURRENT_HOSTNAME | cut -f1 -d' ' | xargs -I{} xauth remove {}"
        su "$SUDO_USER" -c "xauth add \$(xauth -n list | tail -1 | sed 's/^.*\//'$NEW_HOSTNAME'\//g')"
        printf " * X authority file updated\n"
    fi

    systemctl stop avahi-daemon 2>/dev/null

    printf " * Hostname changed to %s\n" "$NEW_HOSTNAME"
}

# Change the MAC address for a chosen network interface
change_mac() {
    printf "Choose a network interface:\n"
    printf "----------------------------\n"
    ls /sys/class/net
    read -p ">>> " macintosh
    printf "\n"

    ip link set "$macintosh" down
    macchanger -r "$macintosh"
    ip link set "$macintosh" up
    macchanger -s "$macintosh"
}

# Check Tor config entries required for transparent proxying
check_configs() {
    MISSING=0

    grep -q -x 'VirtualAddrNetwork 10.192.0.0/10' /etc/tor/torrc || MISSING=1
    grep -q -x 'TransPort 9040'                   /etc/tor/torrc || MISSING=1
    grep -q -x 'DNSPort 53'                        /etc/tor/torrc || MISSING=1
    grep -q -x 'AutomapHostsOnResolve 1'           /etc/tor/torrc || MISSING=1

    if [ $MISSING -ne 0 ]; then
        printf "\n[!] Please add the following to /etc/tor/torrc and restart Tor:\n\n"
        printf ' VirtualAddrNetwork 10.192.0.0/10\n'
        printf ' TransPort 9040\n'
        printf ' DNSPort 53\n'
        printf ' AutomapHostsOnResolve 1\n\n'
        exit 1
    fi
}

iptables_flush() {
    iptables -F
    iptables -t nat -F
    printf " * Deleted all iptables rules\n"
}

# Wait for Tor to be ready
wait_for_tor() {
    printf " * Waiting for Tor to initialize"
    COUNTER=0
    MAX_WAIT=30
    
    while [ $COUNTER -lt $MAX_WAIT ]; do
        # Check if Tor is listening on the TransPort
        if netstat -tuln 2>/dev/null | grep -q ":9040\|:53" || ss -tuln 2>/dev/null | grep -q ":9040\|:53"; then
            printf " (ready)\n"
            return 0
        fi
        
        printf "."
        sleep 1
        COUNTER=$((COUNTER + 1))
    done
    
    printf " (timeout)\n"
    printf "[!] Warning: Tor may not be fully initialized\n"
    return 1
}

# Configure and verify DNS
configure_dns() {
    printf " * Configuring DNS"
    
    # Stop systemd-resolved and ensure it stays stopped
    systemctl stop systemd-resolved 2>/dev/null
    systemctl mask systemd-resolved 2>/dev/null
    
    # Remove any symlink that might exist
    rm -f /etc/resolv.conf 2>/dev/null
    
    # Create a proper resolv.conf file (not a symlink)
    cat > /etc/resolv.conf << 'DNSEOF'
nameserver 127.0.0.1
options timeout:1 attempts:1
DNSEOF
    
    # Make it immutable to prevent systemd from modifying it
    chattr +i /etc/resolv.conf 2>/dev/null
    
    printf " (configured)"
    
    # Test DNS with retries
    COUNTER=0
    MAX_RETRIES=5
    
    while [ $COUNTER -lt $MAX_RETRIES ]; do
        printf "."
        
        if nslookup google.com 127.0.0.1 2>/dev/null | grep -q "Address" || \
           dig @127.0.0.1 google.com +short 2>/dev/null | grep -q "[0-9]"; then
            printf " (working)\n"
            return 0
        fi
        
        sleep 1
        COUNTER=$((COUNTER + 1))
    done
    
    printf " (not responding yet, continuing)\n"
    return 1
}

# Check and configure network
configure_network() {
    printf " * Configuring network interfaces"
    
    # Get all non-loopback interfaces
    INTERFACES=$(ip link show | grep "UP" | grep -v "LOOPBACK" | awk -F': ' '{print $2}' | sed 's/:$//')
    
    if [ -z "$INTERFACES" ]; then
        INTERFACES=$(ip link show | grep -E "^\d+:" | grep -v "LOOPBACK" | awk -F': ' '{print $2}')
    fi
    
    if [ -z "$INTERFACES" ]; then
        printf " (no interfaces found)\n"
        return 1
    fi
    
    # Bring up all interfaces and renew DHCP
    for IFACE in $INTERFACES; do
        printf "."
        ip link set "$IFACE" up 2>/dev/null
        sleep 0.5
    done
    
    # Renew DHCP leases
    for IFACE in $INTERFACES; do
        dhclient "$IFACE" 2>/dev/null &
    done
    
    sleep 3
    
    # Verify at least one interface is up
    ACTIVE=$(ip addr show | grep "inet " | grep -v "127.0.0.1" | awk '{print $NF}' | head -1)
    
    if [ -n "$ACTIVE" ]; then
        IP=$(ip addr show "$ACTIVE" | grep "inet " | awk '{print $2}' | cut -d'/' -f1)
        printf " (online: %s on %s)\n" "$IP" "$ACTIVE"
        return 0
    fi
    
    printf " (offline - no IP assigned)\n"
    return 1
}

# Transparently route all traffic through Tor
redirect_to_tor() {
    printf "\n"

    # Ensure Tor is running and start it if needed
    if ! systemctl is-active --quiet tor; then
        printf "[*] Starting Tor service...\n"
        systemctl unmask tor 2>/dev/null
        systemctl restart tor
        wait_for_tor
    else
        printf "[*] Tor is already running\n"
    fi

    if ! [ -f /etc/network/iptables.rules ]; then
        iptables-save > /etc/network/iptables.rules
        printf " * Saved iptables rules\n"
    fi

    # Backup original resolv.conf before modifying it
    if [ ! -f "$DNS_BACKUP" ]; then
        if [ -f /etc/resolv.conf ]; then
            cp /etc/resolv.conf "$DNS_BACKUP" 2>/dev/null
            printf " * Backed up original resolv.conf\n"
        fi
    fi

    iptables_flush

    # Configure DNS
    configure_dns
    
    # Set up iptables rules
    iptables -t nat -A OUTPUT -m owner --uid-owner $TOR_UID -j RETURN
    iptables -t nat -A OUTPUT -p udp --dport 53 -j REDIRECT --to-ports 53

    for NET in $NON_TOR 127.0.0.0/9 127.128.0.0/10; do
        iptables -t nat -A OUTPUT -d "$NET" -j RETURN
    done

    iptables -t nat -A OUTPUT -p tcp --syn -j REDIRECT --to-ports $TRANS_PORT
    iptables -A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

    for NET in $NON_TOR 127.0.0.0/8; do
        iptables -A OUTPUT -d "$NET" -j ACCEPT
    done

    iptables -A OUTPUT -m owner --uid-owner $TOR_UID -j ACCEPT
    iptables -A OUTPUT -j REJECT

    printf " * Tor transparent proxy configured\n"
}

# BleachBit: delete unnecessary files to preserve privacy
do_bleachbit() {
    if [ "$OVERWRITE" = "true" ] ; then
        printf "\n * Deleting and overwriting unnecessary files... "
        bleachbit -o -c $BLEACHBIT_CLEANERS >/dev/null
    else
        printf "\n * Deleting unnecessary files... "
        bleachbit -c $BLEACHBIT_CLEANERS >/dev/null
    fi
    printf "Done!\n"
}

do_start() {
    check_configs
    check_root

    warning

    printf "\n[i] Starting anonymous mode\n"
    printf "Report bugs to https://github.com/MardoxTV/Kali-Anonymous/issues\n\n"

    nm_stop

    kill_process

    if ask "Do you want to change the MAC address?" Y; then
        change_mac
    fi

    if ask "Do you want to change the local hostname?" Y; then
        read -p "Type a hostname or press Enter for a random one > " CHOICE
        if [ "$CHOICE" = "" ]; then
            change_hostname
        else
            change_hostname "$CHOICE"
        fi
    fi

    if ask "Do you want to transparently route traffic through Tor?" Y; then
        redirect_to_tor
    else
        printf "\n"
    fi

    nm_start
    
    # Configure and verify network and DNS
    printf "\n[*] Finalizing configuration...\n"
    configure_network
    
    printf "\n"
}

do_stop() {
    check_root

    printf "\n[i] Stopping anonymous mode\n\n"

    nm_stop

    iptables_flush

    if [ -f /etc/network/iptables.rules ]; then
        iptables-restore < /etc/network/iptables.rules
        rm /etc/network/iptables.rules
        printf " * Restored iptables rules\n"
    fi

    # Restore DNS configuration from backup
    if [ -f "$DNS_BACKUP" ]; then
        # Make resolv.conf mutable again
        chattr -i /etc/resolv.conf 2>/dev/null
        cp "$DNS_BACKUP" /etc/resolv.conf
        rm "$DNS_BACKUP"
        printf " * Restored original DNS configuration\n"
    else
        # Fallback: restore systemd-resolved
        chattr -i /etc/resolv.conf 2>/dev/null
        systemctl unmask systemd-resolved 2>/dev/null
        systemctl start systemd-resolved 2>/dev/null
        sleep 2
        # Remove any existing resolv.conf file
        rm -f /etc/resolv.conf 2>/dev/null
        # Create proper symlink to systemd-resolved
        ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf 2>/dev/null
        printf " * Restored systemd-resolved DNS\n"
    fi

    kill_process

    if [ "$(virt-what 2>/dev/null)" != "" ]; then
        printf " * Unable to change MAC address in a Virtual Machine\n"
    else
        if ask "Do you want to restore the MAC address?" Y; then
            change_mac
        fi
    fi

    if ask "Do you want to change the local hostname?" Y; then
        read -p "Type a hostname or press Enter to restore default [$REAL_HOSTNAME] > " CHOICE
        if [ "$CHOICE" = "" ]; then
            change_hostname "$REAL_HOSTNAME"
        else
            change_hostname "$CHOICE"
        fi
    else
        printf "\n"
    fi

    nm_start
    systemctl restart tor

    if [ "$DISPLAY" ]; then
        if ask "Delete unnecessary files to preserve your privacy?" Y; then
            do_bleachbit
        fi
    fi

    printf "\n"
}

do_status() {
    printf "\n[i] Showing anonymous status\n\n"

    # List interfaces with MAC addresses using iproute2
    ip link show | awk '/^[0-9]+:/ {iface=$2} /link\/ether/ {print " * " iface, $2}'

    CURRENT_HOSTNAME=$(hostname)
    printf " * Hostname: %s\n" "$CURRENT_HOSTNAME"

    # Get current public IP
    IP=$(curl -s https://api64.ipify.org 2>/dev/null || curl -s https://ifconfig.me 2>/dev/null)

    # Check if Tor is active via check.torproject.org
    HTML=$(curl -s "https://check.torproject.org/?lang=en_US" 2>/dev/null)

    if echo "$HTML" | grep -q "Congratulations. This browser is configured to use Tor."; then
        printf " * IP: %s\n" "$IP"
        printf " * Tor: ON\n\n"
    else
        printf " * IP: %s\n" "$IP"
        printf " * Tor: OFF\n\n"
        exit 3
    fi
}

do_update() {
    printf "\n[i] Updating...\n\n"
    git clone https://github.com/MardoxTV/Kali-Anonymous
    cd kali-anonymous || exit 1
    sh setup.sh
    cd ..
    rm -rf kali-anonymous
    printf "Updated!\n"
}

case "$1" in
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    status)
        do_status
        ;;
    update)
        do_update
        ;;
    *)
        printf "Usage: sudo %s {start|stop|status|update}\n" "$0" >&2
        exit 3
        ;;
esac

exit 0
