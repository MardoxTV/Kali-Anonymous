#!/bin/sh
# Setup script for kali-anonymous on modern Kali Linux (systemd)

printf "\n"
printf "ANONYMOUS SETUP FOR KALI LINUX (MODERN / SYSTEMD)\n"
printf "\n"

# Must be run as root
if [ "$(id -u)" -ne 0 ]; then
    printf "[!] Please run as root: sudo ./setup\n"
    exit 1
fi

# Check we're in the right directory
if [ ! -f "./anonymous" ]; then
    printf "[!] Cannot find the 'anonymous' file in the current directory.\n"
    printf "    Make sure you run this script from inside the Kali-Anonymous folder.\n"
    exit 1
fi

printf "[*] Updating package list...\n\n"
apt-get update || { printf "[!] apt-get update failed\n"; exit 1; }
printf "\n[+] Package list updated!\n\n"

# Install Tor if not already installed
if ! command -v tor >/dev/null 2>&1; then
    printf "[*] Tor not found. Installing...\n"
    apt-get install -y tor || { printf "[!] Failed to install tor\n"; exit 1; }
else
    printf "[+] Tor is already installed.\n"
fi

# Install macchanger if not already installed
if ! command -v macchanger >/dev/null 2>&1; then
    printf "[*] macchanger not found. Installing...\n"
    apt-get install -y macchanger || { printf "[!] Failed to install macchanger\n"; exit 1; }
else
    printf "[+] macchanger is already installed.\n"
fi

# Install curl if not already installed (needed for status check)
if ! command -v curl >/dev/null 2>&1; then
    printf "[*] curl not found. Installing...\n"
    apt-get install -y curl || { printf "[!] Failed to install curl\n"; exit 1; }
else
    printf "[+] curl is already installed.\n"
fi

# Install dhclient if not already installed (needed for DHCP)
if ! command -v dhclient >/dev/null 2>&1; then
    printf "[*] dhclient not found. Installing...\n"
    apt-get install -y isc-dhcp-client || { printf "[!] Failed to install dhclient\n"; exit 1; }
else
    printf "[+] dhclient is already installed.\n"
fi

# Install dnsutils if not already installed (needed for DNS checks)
if ! command -v nslookup >/dev/null 2>&1; then
    printf "[*] dnsutils not found. Installing...\n"
    apt-get install -y dnsutils || { printf "[!] Failed to install dnsutils\n"; exit 1; }
else
    printf "[+] dnsutils is already installed.\n"
fi

# Install net-tools if not already installed (needed for netstat)
if ! command -v netstat >/dev/null 2>&1; then
    printf "[*] net-tools not found. Installing...\n"
    apt-get install -y net-tools || { printf "[!] Failed to install net-tools\n"; exit 1; }
else
    printf "[+] net-tools is already installed.\n"
fi

# Ensure iproute2 is installed (provides ip, ss)
if ! command -v ip >/dev/null 2>&1 || ! command -v ss >/dev/null 2>&1; then
    printf "[*] iproute2 not found. Installing...\n"
    apt-get install -y iproute2 || { printf "[!] Failed to install iproute2\n"; exit 1; }
else
    printf "[+] iproute2 is already installed.\n"
fi

# Ensure iptables is installed (still default on Kali, but be defensive)
if ! command -v iptables >/dev/null 2>&1; then
    printf "[*] iptables not found. Installing...\n"
    apt-get install -y iptables || { printf "[!] Failed to install iptables\n"; exit 1; }
else
    printf "[+] iptables is already installed.\n"
fi

# Ensure procps (pkill/killall) is installed
if ! command -v pkill >/dev/null 2>&1; then
    printf "[*] procps not found. Installing...\n"
    apt-get install -y procps psmisc || { printf "[!] Failed to install procps/psmisc\n"; exit 1; }
else
    printf "[+] procps is already installed.\n"
fi


# Check for e2fsprogs (needed for chattr command)
if ! command -v chattr >/dev/null 2>&1; then
    printf "[*] e2fsprogs not found. Installing...\n"
    apt-get install -y e2fsprogs || { printf "[!] Failed to install e2fsprogs\n"; exit 1; }
else
    printf "[+] e2fsprogs is already installed.\n"
fi

# Optional: virt-what (used to skip MAC change in VMs - non-fatal if absent)
if ! command -v virt-what >/dev/null 2>&1; then
    printf "[*] Installing virt-what (optional)...\n"
    apt-get install -y virt-what || printf "[!] Could not install virt-what (non-fatal)\n"
else
    printf "[+] virt-what is already installed.\n"
fi

# Optional: bleachbit (used to wipe traces on stop - non-fatal if absent)
if ! command -v bleachbit >/dev/null 2>&1; then
    printf "[*] Installing bleachbit (optional)...\n"
    apt-get install -y bleachbit || printf "[!] Could not install bleachbit (non-fatal)\n"
else
    printf "[+] bleachbit is already installed.\n"
fi

# Optional: wordlist for random hostnames - non-fatal if absent
if [ ! -f /usr/share/dict/words ] && [ ! -f /etc/dictionaries-common/words ]; then
    printf "[*] Installing wordlist for random hostnames (optional)...\n"
    apt-get install -y wamerican || printf "[!] Could not install wordlist (non-fatal; falls back to numeric hostnames)\n"
fi

# Optionally install NetworkManager
printf "\n"
if ! command -v nmcli >/dev/null 2>&1; then
    printf "[?] NetworkManager not found.\n"
    printf "    NetworkManager is optional but recommended for better network management.\n"
    printf "    Install it? (y/n) > "
    read -r INSTALL_NM
    case "$INSTALL_NM" in
        y*|Y*) apt-get install -y network-manager || printf "[!] Failed to install NetworkManager (non-fatal)\n" ;;
        *) printf "[*] Skipping NetworkManager installation.\n" ;;
    esac
else
    printf "[+] NetworkManager is already installed.\n"
fi

# Add required Tor config entries (only if not already present)
printf "\n[*] Checking Tor configuration...\n"
TORRC="/etc/tor/torrc"

if [ ! -f "$TORRC" ]; then
    printf "[!] Tor config file not found at %s\n" "$TORRC"
    exit 1
fi

grep -q 'VirtualAddrNetwork 10.192.0.0/10' "$TORRC" || echo 'VirtualAddrNetwork 10.192.0.0/10' >> "$TORRC"
grep -q 'TransPort 9040'                   "$TORRC" || echo 'TransPort 9040'                   >> "$TORRC"
grep -q 'DNSPort 53'                       "$TORRC" || echo 'DNSPort 53'                       >> "$TORRC"
grep -q 'AutomapHostsOnResolve 1'          "$TORRC" || echo 'AutomapHostsOnResolve 1'          >> "$TORRC"

printf "[+] Tor configuration updated.\n\n"

# Enable and start Tor via systemd
printf "[*] Enabling Tor service...\n"
systemctl unmask tor 2>/dev/null
systemctl enable tor 2>/dev/null || printf "[!] Could not enable tor service (non-fatal)\n"
systemctl restart tor 2>/dev/null || { printf "[!] Failed to start tor\n"; exit 1; }

# Give Tor a moment to come up, then verify
sleep 2
if systemctl is-active --quiet tor; then
    printf "[+] Tor service running.\n\n"
else
    printf "[!] Tor service is NOT active. Check 'systemctl status tor' / 'journalctl -u tor'\n"
    printf "    Setup will continue, but 'anonymous start' will not work until Tor runs.\n\n"
fi

# Create runtime state directory used for backups during start/stop
mkdir -p /var/lib/kali-anonymous
chmod 700 /var/lib/kali-anonymous

# Copy the main script
printf "[*] Installing anonymous to /usr/sbin/anonymous...\n"
cp ./anonymous /usr/sbin/anonymous || { printf "[!] Failed to copy anonymous script\n"; exit 1; }
chmod 755 /usr/sbin/anonymous
printf "[+] Done.\n\n"

# Copy default config file if it exists, otherwise create a minimal one
if [ -f "./kali-anonymous" ]; then
    printf "[*] Installing config to /etc/default/kali-anonymous...\n"
    cp ./kali-anonymous /etc/default/kali-anonymous
    printf "[+] Done.\n\n"
else
    printf "[*] No config file found, creating default at /etc/default/kali-anonymous...\n"
    cat > /etc/default/kali-anonymous <<'CONFIGEOF'
# kali-anonymous default configuration
# Edit this file to customise behaviour

# Networks that bypass Tor (local subnets)
NON_TOR="192.168.0.0/16 172.16.0.0/12"

# UID that Tor runs as
TOR_UID="debian-tor"

# Tor transparent proxy port
TRANS_PORT="9040"

# Processes to kill on start/stop
TO_KILL="chrome chromium dropbox firefox pidgin skype thunderbird xchat"

# BleachBit cleaners to run on stop
BLEACHBIT_CLEANERS="bash.history system.cache system.clipboard system.custom system.recent_documents system.rotated_logs system.tmp system.trash"

# Overwrite files when cleaning (true/false)
OVERWRITE="true"

# Default hostname to restore when stopping
REAL_HOSTNAME="kali"
CONFIGEOF
    printf "[+] Default config created.\n\n"
fi

printf "============================================\n"
printf " Install complete!\n"
printf "============================================\n"
printf " START:  sudo anonymous start\n"
printf " STOP:   sudo anonymous stop\n"
printf " STATUS: sudo anonymous status\n"
printf " UPDATE: sudo anonymous update\n"
printf "============================================\n"
printf " Report bugs: https://github.com/MardoxTV/Kali-Anonymous/issues\n\n"
